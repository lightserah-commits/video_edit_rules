{
"i": 25,
"sec": 353.97,
"end": 354.55,
"text": "緒だよね"
},
{
"i": 26,
"sec": 354.89,
"end": 357.12,
"text": "お前の仕事終わるんかっていう前の仕事を"
},
{
"i": 27,
"sec": 357.12,
"end": 358.61,
"text": "本当に終わらせてくれちゃんと"
},
{
"i": 28,
"sec": 358.92,
"end": 361.4,
"text": "それだけの話だよね居酒屋とか行くじゃない"
},
{
"i": 29,
"sec": 361.4,
"end": 361.56,
"text": "ですか"
},
{
"i": 30,
"sec": 362.0,
"end": 363.64,
"text": "たまに会社員とか行ってるじゃないですか"
},
