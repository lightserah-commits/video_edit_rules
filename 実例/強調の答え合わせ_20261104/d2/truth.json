{
"i": 45,
"sec": 394.78,
"end": 395.4,
"text": "大事にそういうところ"
},
{
"i": 46,
"sec": 395.71,
"end": 398.09,
"text": "AIうまく使うっていうのは全然そういう"
},
{
"i": 47,
"sec": 398.09,
"end": 401.07,
"text": "ところじゃなくてっと仕事とかと目指してる"
},
{
"i": 48,
"sec": 401.07,
"end": 404.1,
"text": "のよかに仕事うまくやるかみたいな話に局聞"
},
{
"i": 49,
"sec": 404.1,
"end": 406.58,
"text": "けつつんだよ発者とかってよくいいんだよン"
