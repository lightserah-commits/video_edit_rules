{
"i": 19,
"sec": 339.44,
"end": 339.62,
"text": "じゃん"
},
{
"i": 20,
"sec": 339.99,
"end": 342.4,
"text": "これをいかに探すかってゲームだねだけど受"
},
{
"i": 21,
"sec": 342.4,
"end": 344.52,
"text": "験勉強減ったのやつってさっとこうやって教"
