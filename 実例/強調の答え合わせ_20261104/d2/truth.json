},
{
"i": 12,
"sec": 324.98,
"end": 327.03,
"text": "験で解いても解けてるんだ問題集やって解け"
},
{
"i": 13,
"sec": 327.03,
"end": 329.81,
"text": "ないってなって科書見たり答え見たりして"
},
{
"i": 14,
"sec": 330.16,
"end": 332.71,
"text": "いうことかって言ってもう一回解き直してけ"
},
{
"i": 15,
"sec": 332.71,
"end": 335.18,
"text": "たらよしOKので解けなかったから今度覚"
},
{
"i": 16,
"sec": 335.18,
"end": 336.34,
"text": "えてるかチェックしようっていうのはチェ"
},
{
"i": 17,
"sec": 336.34,
"end": 338.22,
"text": "ックつけとくっていう回間違えたよってチェ"
},
{
"i": 18,
"sec": 338.22,
"end": 339.44,
"text": "ックつけとくっていうのがポイントなわけ"
