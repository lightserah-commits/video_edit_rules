{
"i": 41,
"sec": 387.68,
"end": 389.18,
"text": "ちよくなることが目的ならそれでいいんだ"
},
{
"i": 42,
"sec": 389.18,
"end": 390.82,
"text": "けどまくいきたいんでしょっていうビになり"
},
{
"i": 43,
"sec": 390.82,
"end": 393.04,
"text": "たくないんでしょ失業したくないんでしょ豊"
