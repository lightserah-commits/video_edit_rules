"lines": [
{
"i": 0,
"sec": 300.05,
"end": 302.39,
"text": "なってる頑の張ってん頑張んなくてなんか"
},
{
"i": 1,
"sec": 302.39,
"end": 304.43,
"text": "こうふんふんって遊びながら日大きました"
},
{
"i": 2,
"sec": 304.43,
"end": 305.39,
"text": "とかだったらめっちゃいいじゃんって感じ"
},
{
"i": 3,
"sec": 305.39,
"end": 305.73,
"text": "なんだけど"
},
{
"i": 4,
"sec": 307.17,
"end": 309.36,
"text": "が今言いたかったのは頑張ってるつもり"
},
{
"i": 5,
"sec": 309.36,
"end": 311.16,
"text": "っていうのとしく頑張るって"
