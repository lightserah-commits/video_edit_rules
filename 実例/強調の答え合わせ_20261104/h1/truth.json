{
"ref": "1",
"name": "完成版1 AI使いこなす習慣7選",
"from": 1200.0,
"to": 1620.0,
"lines": [
{
"i": 0,
"sec": 1200.02,
"end": 1201.2,
"text": "それは分かんないじゃないですか本当本当"
},
{
"i": 1,
"sec": 1201.2,
"end": 1201.42,
"text": "そう"
},
{
"i": 2,
"sec": 1202.37,
"end": 1204.27,
"text": "この情報ダメだったんだっていうのは分かる"
},
{
"i": 3,
"sec": 1204.27,
"end": 1204.59,
"text": "分"
},
{
"i": 4,
"sec": 1205.47,
"end": 1206.81,
"text": "時にはもう遅かったりするじゃないですか"
},
{
"i": 5,
"sec": 1207.31,
"end": 1209.81,
"text": "やる気なくなるくらいならいう情報を学ばず"
},
{
"i": 6,
"sec": 1209.81,
"end": 1212.17,
"text": "に一旦最先端の情報を僕らから学んでほしい"
},
{
"i": 7,
"sec": 1212.17,
"end": 1214.59,
"text": "なって思うのでマジでそうなんでず動画下の"
},
{
"i": 8,
"sec": 1214.59,
"end": 1216.5,
"text": "概要欄からンは受けといてください悪いこと"
},
{
"i": 9,
"sec": 1216.5,
"end": 1218.75,
"text": "はないと思うわかじゃあ次週刊5なんだけど"
},
{
"i": 10,
"sec": 1218.75,
"end": 1221.17,
"text": "週刊5はさっきもねチラッと言ったんだけど"
},
{
"i": 11,
"sec": 1221.17,
"end": 1222.07,
"text": "スマホから"
},
{
"i": 12,
"sec": 1222.53,
"end": 1225.95,
"text": "をかすめっちゃ大事僕のソコンとかね例えば"
},
{
"i": 13,
"sec": 1225.95,
"end": 1229.1,
"text": "僕だったらやってるのはよいしょよいしょ実"
},
{
"i": 14,
"sec": 1229.1,
"end": 1233.3,
"text": "はね実は実は感じで実は実はここにほら"
},
{
"i": 15,
"sec": 1233.3,
"end": 1234.52,
"text": "MacBookProって書いてあるでしょ"
},
{
"i": 16,
"sec": 1235.12,
"end": 1236.33,
"text": "ここにちっちゃく"
},
{
"i": 17,
"sec": 1236.67,
"end": 1238.12,
"text": "BookProって書いてあるじゃんね、"
},
{
"i": 18,
"sec": 1238.38,
"end": 1240.3,
"text": "MacBookProに指示出しますって"
},
{
"i": 19,
"sec": 1240.3,
"end": 1240.51,
"text": "ことなんです。"
},
{
"i": 20,
"sec": 1240.45,
"end": 1241.45,
"text": "MacBookProこれ。"
},
{
"i": 21,
"sec": 1241.91,
"end": 1243.23,
"text": "あとはここにあるMacmini。"
},
{
"i": 22,
"sec": 1243.77,
"end": 1244.89,
"text": "Macminiにも行ける。"
},
{
"i": 23,
"sec": 1244.95,
"end": 1246.93,
"text": "だからこいつを持って行った時はこいつに行"
},
{
"i": 24,
"sec": 1246.93,
"end": 1248.23,
"text": "くし、松屋とか行って、"
},
{
"i": 25,
"sec": 1248.59,
"end": 1251.06,
"text": "松屋で牛丼食いながら、こいつ止まってるわ"
},
{
"i": 26,
"sec": 1251.06,
"end": 1252.46,
"text": "って示していておく。"
},
{
"i": 27,
"sec": 1252.48,
"end": 1253.14,
"text": "そんなずっと"
},
{
"i": 28,
"sec": 1253.59,
"end": 1254.11,
"text": "せてるんですか?"
},
{
"i": 29,
"sec": 1254.15,
"end": 1254.45,
"text": "そうよ。"
},
{
"i": 30,
"sec": 1254.66,
"end": 1255.34,
"text": "24時間ロード。"
},
{
"i": 31,
"sec": 1255.42,
"end": 1257.58,
"text": "そんなんできるんですねそうそうだって今も"
},
{
"i": 32,
"sec": 1257.58,
"end": 1260.75,
"text": "働いてるしねこの子働いてるよほらこの子今"
},
{
"i": 33,
"sec": 1260.99,
"end": 1263.82,
"text": "54分作業してる撮影来るちょい前くらいに"
},
{
"i": 34,
"sec": 1263.82,
"end": 1266.41,
"text": "なんだって言ったやつがまだ働いてる撮影し"
},
{
"i": 35,
"sec": 1266.41,
"end": 1268.22,
"text": "ながら働もいてますすごいでしょ"
},
{
"i": 36,
"sec": 1268.78,
"end": 1271.34,
"text": "それはだいぶ差開いてきそうですよね人で"
},
{
"i": 37,
"sec": 1271.34,
"end": 1271.96,
"text": "やってるか"
},
{
"i": 38,
"sec": 1272.26,
"end": 1274.41,
"text": "人間がいっぱいいてるかそうそう本当に本当"
},
{
"i": 39,
"sec": 1274.41,
"end": 1275.47,
"text": "に1対10くらいの"
},
{
"i": 40,
"sec": 1276.07,
"end": 1277.72,
"text": "影分身影分身影ばいでしょ"
},
{
"i": 41,
"sec": 1278.06,
"end": 1278.98,
"text": "本当にそんな感じ"
},
{
"i": 42,
"sec": 1279.88,
"end": 1282.22,
"text": "自然とそうしてる別にこんなの打ち合わせ"
},
{
"i": 43,
"sec": 1282.22,
"end": 1284.24,
"text": "もしないじゃなんかん普通に働いてる普通の"
},
{
"i": 44,
"sec": 1284.24,
"end": 1286.04,
"text": "方でもできるんですか一般の方たち普"
},
{
"i": 45,
"sec": 1286.58,
"end": 1289.19,
"text": "ににね接続を追加ってある"
},
{
"i": 46,
"sec": 1289.59,
"end": 1292.07,
"text": "この接続を追加ってのを押すとほらこんな"
},
{
"i": 47,
"sec": 1292.07,
"end": 1294.47,
"text": "感じでQRコードをスキャンしてペアリング"
},
{
"i": 48,
"sec": 1294.47,
"end": 1295.91,
"text": "って書いてある簡単で"
},
{
"i": 49,
"sec": 1296.21,
"end": 1299.43,
"text": "Rコードをねこのコーデックスでこの辺で"
},
{
"i": 50,
"sec": 1299.43,
"end": 1300.35,
"text": "なんか開いて"
},
{
"i": 51,
"sec": 1300.67,
"end": 1301.77,
"text": "これで追加って"
},
{
"i": 52,
"sec": 1302.22,
"end": 1302.72,
"text": "ったらほら"
},
{
"i": 53,
"sec": 1303.05,
"end": 1305.95,
"text": "感じで出てくるからこれを読み込んでこう"
},
{
"i": 54,
"sec": 1305.95,
"end": 1308.72,
"text": "やってピッて読み込んでれば一回み込むとと"
},
{
"i": 55,
"sec": 1308.72,
"end": 1310.92,
"text": "なんと安全なセットアップを完了しています"
},
{
"i": 56,
"sec": 1310.92,
"end": 1311.38,
"text": "というので"
},
{
"i": 57,
"sec": 1311.9,
"end": 1313.47,
"text": "ットアップされましたそんな簡単にできる"
},
{
"i": 58,
"sec": 1313.47,
"end": 1314.2,
"text": "んです簡単に"
},
{
"i": 59,
"sec": 1314.59,
"end": 1317.48,
"text": "これだけわりパソコン閉じてても動かせる"
},
{
"i": 60,
"sec": 1317.48,
"end": 1318.56,
"text": "んですか閉じちゃダメ"
},
{
"i": 61,
"sec": 1319.02,
"end": 1321.59,
"text": "じゃあ副業とかをソコンに例えばやらせたり"
},
{
"i": 62,
"sec": 1321.59,
"end": 1321.75,
"text": "とか"
},
{
"i": 63,
"sec": 1322.29,
"end": 1324.63,
"text": "業務やらせたりなったときはとかでパソコン"
},
{
"i": 64,
"sec": 1324.63,
"end": 1326.61,
"text": "開きっぱなしその通り簡単でしょだから家で"
},
{
"i": 65,
"sec": 1326.61,
"end": 1327.99,
"text": "パソコン開いて置いといて"
},
{
"i": 66,
"sec": 1328.39,
"end": 1329.98,
"text": "場のトイレで指示出せるめっちゃいいっす"
},
{
"i": 67,
"sec": 1329.98,
"end": 1331.58,
"text": "これガチみんなそうやってやってる"
},
{
"i": 68,
"sec": 1331.99,
"end": 1333.87,
"text": "みんなそうやってるんだよやってる人は"
},
{
"i": 69,
"sec": 1334.56,
"end": 1336.78,
"text": "俺最近あんまりパソコン持ち歩かない日も増"
},
{
"i": 70,
"sec": 1336.78,
"end": 1339.07,
"text": "えてるパソコンで画面見せたいときとかはパ"
},
{
"i": 71,
"sec": 1339.07,
"end": 1340.95,
"text": "ソコン持ってるけどねパソコン持ってたとき"
},
{
"i": 72,
"sec": 1340.95,
"end": 1341.91,
"text": "のためにこいつがいる"
},
{
"i": 73,
"sec": 1342.75,
"end": 1345.26,
"text": "万全の体制でチャット型AIでも使えたり"
},
{
"i": 74,
"sec": 1345.26,
"end": 1347.32,
"text": "しますかチャット型AIは別にスマホで使う"
},
{
"i": 75,
"sec": 1347.32,
"end": 1349.05,
"text": "がPC変わらないからーデックスとかこう"
},
{
"i": 76,
"sec": 1349.05,
"end": 1351.15,
"text": "いうクロードコードとかこういうような類の"
},
{
"i": 77,
"sec": 1351.15,
"end": 1353.15,
"text": "やつはパソコンの開発能力とかを思いっきり"
},
{
"i": 78,
"sec": 1353.15,
"end": 1354.67,
"text": "ガーッと使うからソコンじゃなきゃダメなん"
},
{
"i": 79,
"sec": 1354.67,
"end": 1356.69,
"text": "でスマホじゃ厳しいっていうのでパソコン"
},
{
"i": 80,
"sec": 1356.69,
"end": 1357.41,
"text": "じゃないといけない"
},
{
"i": 81,
"sec": 1357.86,
"end": 1360.44,
"text": "あとはスマホ連携と一緒にこれも紹介しちゃ"
},
{
"i": 82,
"sec": 1360.44,
"end": 1363.2,
"text": "うんだけどやっぱ音声入力音声入力はやっぱ"
},
{
"i": 83,
"sec": 1363.2,
"end": 1363.92,
"text": "めちゃくちゃ大事"
},
{
"i": 84,
"sec": 1364.54,
"end": 1366.7,
"text": "例えばにしようこのボンジ徹底プロジェクト"
},
{
"i": 85,
"sec": 1366.7,
"end": 1368.28,
"text": "なんか他の何か考えるっていうので"
},
{
"i": 86,
"sec": 1368.66,
"end": 1369.08,
"text": "るとして"
},
{
"i": 87,
"sec": 1370.4,
"end": 1370.5,
"text": "な"
},
{
"i": 88,
"sec": 1371.22,
"end": 1371.98,
"text": "常タスクでさ"
},
{
"i": 89,
"sec": 1372.48,
"end": 1375.17,
"text": "いろいろねやったほうがいいなみたいな特に"
},
{
"i": 90,
"sec": 1375.17,
"end": 1376.09,
"text": "マネジメント関連から"
},
{
"i": 91,
"sec": 1376.54,
"end": 1378.96,
"text": "その辺で盆地徹底するためにこれをやった方"
},
{
"i": 92,
"sec": 1378.96,
"end": 1380.36,
"text": "がいいよみたいなことを考えないんじゃない"
},
{
"i": 93,
"sec": 1380.36,
"end": 1383.04,
"text": "かないい感じで考えてみてほしいなっていう"
},
{
"i": 94,
"sec": 1383.84,
"end": 1386.26,
"text": "声入力は非常に大事ですよくやりますスマホ"
},
{
"i": 95,
"sec": 1386.26,
"end": 1388.32,
"text": "からの操作と音声入力2つは"
},
{
"i": 96,
"sec": 1388.72,
"end": 1391.92,
"text": "必須かな習得必須の習慣です倍くらい変わる"
},
{
"i": 97,
"sec": 1391.92,
"end": 1394.4,
"text": "って言いますよね音声入力とタイピングの速"
},
{
"i": 98,
"sec": 1394.4,
"end": 1396.12,
"text": "度ねでだって今の異常なスピードだったじゃ"
},
{
"i": 99,
"sec": 1396.12,
"end": 1396.26,
"text": "ん"
},
{
"i": 100,
"sec": 1396.56,
"end": 1399.49,
"text": "かねあとねスピードよりも頭が変わる頭の使"
},
{
"i": 101,
"sec": 1399.49,
"end": 1401.55,
"text": "い方が変わるのがポイントイピングするかの"
},
{
"i": 102,
"sec": 1401.55,
"end": 1404.0,
"text": "ように喋るんじゃなくて話しするかのように"
},
{
"i": 103,
"sec": 1404.0,
"end": 1404.22,
"text": "喋る"
},
{
"i": 104,
"sec": 1404.57,
"end": 1406.82,
"text": "だから入力は適当でいいの逆に言うといや"
},
{
"i": 105,
"sec": 1406.82,
"end": 1408.62,
"text": "どうなんだろうねいやでもどう思も思わ"
},
{
"i": 106,
"sec": 1408.62,
"end": 1408.76,
"text": "ない?"
},
{
"i": 107,
"sec": 1408.9,
"end": 1410.0,
"text": "いやあのさーみたいな"
},
{
"i": 108,
"sec": 1410.3,
"end": 1412.59,
"text": "喋ればいい会話になるからなんかね発想力が"
},
{
"i": 109,
"sec": 1412.59,
"end": 1414.61,
"text": "上がるんだよねんなさ会議とかするじゃん"
},
{
"i": 110,
"sec": 1414.55,
"end": 1416.45,
"text": "あれなんでかっていうと会議ってアイデア出"
},
{
"i": 111,
"sec": 1416.45,
"end": 1418.71,
"text": "るんだよ会議な気持ちで喋るそうするとアイ"
},
{
"i": 112,
"sec": 1418.71,
"end": 1420.55,
"text": "デア出る確イピングでさアイデア出ないから"
},
{
"i": 113,
"sec": 1420.55,
"end": 1421.74,
"text": "あんまりでも話してたら"
},
{
"i": 114,
"sec": 1422.42,
"end": 1424.98,
"text": "に頭使うの苦手な人ほどしたらめっちゃしゃ"
},
{
"i": 115,
"sec": 1424.98,
"end": 1426.54,
"text": "べれるとかあるかんですそうそうそうそう"
},
{
"i": 116,
"sec": 1428.4,
"end": 1429.55,
"text": "ま絶対です"
},
{
"i": 117,
"sec": 1429.86,
"end": 1433.06,
"text": "が一番ですとは習慣6個目だねこれは"
},
{
"i": 118,
"sec": 1433.4,
"end": 1435.78,
"text": "段使ってないAIを使ってみるってこと"
},
{
"i": 119,
"sec": 1435.93,
"end": 1437.82,
"text": "これは結構おすすめかな逆に"
},
{
"i": 120,
"sec": 1438.22,
"end": 1440.02,
"text": "ってないAIを使うんですかってるAIを使"
},
{
"i": 121,
"sec": 1440.02,
"end": 1442.08,
"text": "うのは当たり前だから例えば俺だったらねコ"
},
{
"i": 122,
"sec": 1442.08,
"end": 1445.08,
"text": "ーデックスが結構メインなんだけどやっぱり"
},
{
"i": 123,
"sec": 1445.08,
"end": 1447.23,
"text": "たまにクロードコードを使うと全然クいいな"
},
{
"i": 124,
"sec": 1447.23,
"end": 1449.66,
"text": "ってなるしあとはそれこそチャットGPTも"
},
{
"i": 125,
"sec": 1449.66,
"end": 1452.02,
"text": "使うしあとやっぱクロードも使うェミニだけ"
},
{
"i": 126,
"sec": 1452.02,
"end": 1452.62,
"text": "あんま使う"
},
{
"i": 127,
"sec": 1453.36,
"end": 1455.84,
"text": "ちょっと中級者向けのAIを使いこなして"
},
{
"i": 128,
"sec": 1455.84,
"end": 1458.22,
"text": "ちょっと休憩がてらいんなAIを使って気分"
},
{
"i": 129,
"sec": 1458.41,
"end": 1460.36,
"text": "でちょっと別のもたまには使ってみた方が"
},
{
"i": 130,
"sec": 1460.36,
"end": 1461.25,
"text": "いいやっぱりちゃん"
},
{
"i": 131,
"sec": 1461.83,
"end": 1463.29,
"text": "使ってる人とかは感してくれるんじゃない"
},
{
"i": 132,
"sec": 1463.29,
"end": 1463.61,
"text": "かな"
},
{
"i": 133,
"sec": 1464.23,
"end": 1466.03,
"text": "使ってる定義なんですけどどれくらい使"
},
{
"i": 134,
"sec": 1466.03,
"end": 1467.63,
"text": "ってる人はこういうことやってた方がいい"
},
{
"i": 135,
"sec": 1467.63,
"end": 1470.5,
"text": "とかあります普通に何でもできるなみたいな"
},
{
"i": 136,
"sec": 1470.68,
"end": 1472.6,
"text": "使えば何でもできるなーってなってるぐらい"
},
{
"i": 137,
"sec": 1472.6,
"end": 1475.21,
"text": "の人かな設定がよくわからないとかなんで"
},
{
"i": 138,
"sec": 1475.21,
"end": 1477.05,
"text": "とかっていう段階だったら別に一つでいい"
},
{
"i": 139,
"sec": 1477.05,
"end": 1478.99,
"text": "と思うそれ使いこなそうが大前提かな"
},
{
"i": 140,
"sec": 1479.63,
"end": 1482.77,
"text": "が6です週刊7これはねAIを信じないだね"
},
{
"i": 141,
"sec": 1482.68,
"end": 1483.9,
"text": "AIは信じないなるほど"
},
{
"i": 142,
"sec": 1484.24,
"end": 1486.72,
"text": "信じたらダメだ信じたらダメだっと言うと"
},
{
"i": 143,
"sec": 1486.72,
"end": 1489.38,
"text": "AIに丸投げして自分がついていくのをや"
},
{
"i": 144,
"sec": 1489.38,
"end": 1491.36,
"text": "めてはならないこれはねアンドレー・カーパ"
},
{
"i": 145,
"sec": 1491.36,
"end": 1493.57,
"text": "シーっていうねオープンAIの共同創業者"
},
{
"i": 146,
"sec": 1493.57,
"end": 1496.35,
"text": "さんがいてねその人がった有名な言葉がある"
},
{
"i": 147,
"sec": 1496.35,
"end": 1498.3,
"text": "んだけどcanoutsource"
},
{
"i": 148,
"sec": 1498.83,
"end": 1500.32,
"text": "wecannever"
},
{
"i": 149,
"sec": 1500.79,
"end": 1502.2,
"text": "ourcenderstanding"
},
{
"i": 150,
"sec": 1502.52,
"end": 1505.36,
"text": "言葉があってね私たちはいつでも考えること"
},
{
"i": 151,
"sec": 1505.36,
"end": 1507.75,
"text": "を外注できるようになりましたでも私たち"
},
{
"i": 152,
"sec": 1508.15,
"end": 1511.45,
"text": "かなるときも解することだけは注できません"
},
{
"i": 153,
"sec": 1511.45,
"end": 1513.45,
"text": "っていう言葉があるのねえるっていうことは"
},
{
"i": 154,
"sec": 1513.45,
"end": 1514.09,
"text": "任せたらいい"
},
{
"i": 155,
"sec": 1514.54,
"end": 1516.92,
"text": "でもなるほどねっていうのだけは自分でやら"
},
{
"i": 156,
"sec": 1516.92,
"end": 1518.7,
"text": "ないといけないだからAIが何を言ったと"
},
{
"i": 157,
"sec": 1518.7,
"end": 1520.81,
"text": "しても解はしないといけないんだよねなんか"
},
{
"i": 158,
"sec": 1520.81,
"end": 1522.93,
"text": "よくわからんけどうまくいったこれが成り立"
},
{
"i": 159,
"sec": 1522.93,
"end": 1523.25,
"text": "つのは"
},
{
"i": 160,
"sec": 1523.58,
"end": 1525.41,
"text": "初だけなんかよくわからんけどうまくい"
},
{
"i": 161,
"sec": 1525.41,
"end": 1527.49,
"text": "ってるっていう状態は長続きしません絶対ど"
},
{
"i": 162,
"sec": 1527.49,
"end": 1529.2,
"text": "っかでおかしくなるかしくなったら直せない"
},
{
"i": 163,
"sec": 1529.2,
"end": 1530.77,
"text": "からだから絶対に理解しなきゃいけない"
},
{
"i": 164,
"sec": 1530.8,
"end": 1532.71,
"text": "っていうのがあってねだからAIが言うこと"
},
{
"i": 165,
"sec": 1532.71,
"end": 1535.36,
"text": "を信じないAIが言ったことのうち理解でき"
},
{
"i": 166,
"sec": 1535.36,
"end": 1537.43,
"text": "ないことをわかったってやっちゃダメ感じ"
},
{
"i": 167,
"sec": 1537.88,
"end": 1538.46,
"text": "すごく大事"
},
{
"i": 168,
"sec": 1539.04,
"end": 1541.58,
"text": "解しない適当なやつでダメになるやつの典型"
},
{
"i": 169,
"sec": 1541.58,
"end": 1543.29,
"text": "的なパターンはっちがいいですかってやった"
},
{
"i": 170,
"sec": 1543.29,
"end": 1544.65,
"text": "時にかんないからおすすめでとかってや"
},
{
"i": 171,
"sec": 1544.65,
"end": 1546.41,
"text": "っちゃう人こういうのやるとねやっぱりどん"
},
{
"i": 172,
"sec": 1546.41,
"end": 1546.95,
"text": "どんダメになる"
},
{
"i": 173,
"sec": 1547.37,
"end": 1549.39,
"text": "だからそういうパターン出してきた時とか"
},
{
"i": 174,
"sec": 1549.39,
"end": 1551.17,
"text": "ってよく分かんないから説明させればいい"
},
{
"i": 175,
"sec": 1551.17,
"end": 1553.86,
"text": "んだよね僕だったらそういう比較検討をする"
},
{
"i": 176,
"sec": 1553.86,
"end": 1556.38,
"text": "時んどいじゃん自分で理解するの比較検討ス"
},
{
"i": 177,
"sec": 1556.38,
"end": 1558.01,
"text": "キルっていうのを作っててそのよく分からん"
},
{
"i": 178,
"sec": 1558.01,
"end": 1560.27,
"text": "からちょっとパターンで比較検討いって言"
},
{
"i": 179,
"sec": 1560.27,
"end": 1562.19,
"text": "った時にその比較検討スキルっていうので"
},
{
"i": 180,
"sec": 1562.53,
"end": 1564.73,
"text": "AIが考えていることっていうのをバンバ"
},
{
"i": 181,
"sec": 1564.73,
"end": 1566.93,
"text": "ンバンバン出してそれをちゃんと説明してく"
},
{
"i": 182,
"sec": 1566.93,
"end": 1568.32,
"text": "れるれがいいかちゃんと選んでください"
},
{
"i": 183,
"sec": 1568.32,
"end": 1570.26,
"text": "っていう風にばせてくれるっていうスキルが"
},
{
"i": 184,
"sec": 1570.23,
"end": 1571.48,
"text": "とかある比較検討スキあとル"
},
{
"i": 185,
"sec": 1571.84,
"end": 1574.22,
"text": "は修正フィードバックスキルみたいのを僕が"
},
{
"i": 186,
"sec": 1574.22,
"end": 1574.54,
"text": "作っている"
},
{
"i": 187,
"sec": 1575.07,
"end": 1577.58,
"text": "これはいまいちAIが微妙なのを出してきた"
},
{
"i": 188,
"sec": 1577.58,
"end": 1579.74,
"text": "時とかにここが悪いからこうしましょう"
},
{
"i": 189,
"sec": 1579.74,
"end": 1580.26,
"text": "みたいな"
},
{
"i": 190,
"sec": 1580.57,
"end": 1582.77,
"text": "いうAIのダメなところみたいなものを"
},
{
"i": 191,
"sec": 1582.77,
"end": 1584.27,
"text": "ちゃんと解してそれを"
},
{
"i": 192,
"sec": 1584.58,
"end": 1585.88,
"text": "正するっていうプロセスを"
},
{
"i": 193,
"sec": 1586.26,
"end": 1587.98,
"text": "単に進められるようなスキルを作っていただ"
},
{
"i": 194,
"sec": 1587.98,
"end": 1588.2,
"text": "けます"
},
{
"i": 195,
"sec": 1588.63,
"end": 1591.33,
"text": "こんな感じでAIを鵜呑みにしない習慣"
},
{
"i": 196,
"sec": 1591.33,
"end": 1592.95,
"text": "みたいなものは絶対につけたほうがいい"
},
{
"i": 197,
"sec": 1593.26,
"end": 1595.87,
"text": "キルって何なんですかスルっていうのは技マ"
},
{
"i": 198,
"sec": 1595.87,
"end": 1596.53,
"text": "シンみたいなもんで"
},
{
"i": 199,
"sec": 1596.84,
"end": 1597.86,
"text": "AIって結局"
},
{
"i": 200,
"sec": 1598.58,
"end": 1600.64,
"text": "番最初にさこうやってメッセージ投げるじゃ"
},
{
"i": 201,
"sec": 1600.64,
"end": 1602.46,
"text": "んそしたらAIがメッセージ投げてこう"
},
{
"i": 202,
"sec": 1602.46,
"end": 1604.61,
"text": "やってわかりましたって言ってこうやって返"
},
{
"i": 203,
"sec": 1604.61,
"end": 1606.61,
"text": "答するわけで返ってくるじゃんじゃあ次にさ"
},
{
"i": 204,
"sec": 1606.61,
"end": 1608.21,
"text": "俺こうがいうメッセージ投げるじゃそしたら"
},
{
"i": 205,
"sec": 1608.21,
"end": 1609.59,
"text": "AIがわかりましたって言ってまたこういう"
},
{
"i": 206,
"sec": 1609.59,
"end": 1611.3,
"text": "メッセージっていう風にこうメッセージ返"
},
{
"i": 207,
"sec": 1611.3,
"end": 1613.11,
"text": "ってくるんだよいう仕組みなんだけどやって"
},
{
"i": 208,
"sec": 1613.11,
"end": 1615.51,
"text": "やっていくとさ忘れちゃうわけ指示指示忘れ"
},
{
"i": 209,
"sec": 1615.51,
"end": 1617.28,
"text": "ちゃうと言ったじゃんみたいなことになるわ"
},
{
"i": 210,
"sec": 1617.28,
"end": 1619.75,
"text": "けこれうざいわけよだからいつでもどこでも"
},
{
"i": 211,
"sec": 1619.75,
"end": 1620.25,
"text": "AI"
}
],
