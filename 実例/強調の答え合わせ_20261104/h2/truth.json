{
"ref": "2",
"name": "完成版2 AI時代に消える仕事残る仕事",
"from": 1000.0,
"to": 1420.0,
"lines": [
{
"i": 0,
"sec": 1000.17,
"end": 1000.79,
"text": "やって削るんじゃ?"
},
{
"i": 1,
"sec": 1000.91,
"end": 1002.66,
"text": "ってすぐ分かると思うから、いうの見てほ"
},
{
"i": 2,
"sec": 1002.66,
"end": 1005.53,
"text": "しいその上で、テップ3としては、攻めの領"
},
{
"i": 3,
"sec": 1005.53,
"end": 1005.75,
"text": "域"
},
{
"i": 4,
"sec": 1006.2,
"end": 1008.89,
"text": "くしていく必要があるめの領域くを"
},
{
"i": 5,
"sec": 1012.06,
"end": 1014.11,
"text": "っと上手くろうとかもっと丁寧にやろうとか"
},
{
"i": 6,
"sec": 1014.29,
"end": 1016.08,
"text": "までってそれが大事だったね経理だったらミ"
},
{
"i": 7,
"sec": 1016.08,
"end": 1017.86,
"text": "スなくやることが大事だったしンジニアだ"
},
{
"i": 8,
"sec": 1017.86,
"end": 1019.92,
"text": "ったらコードを早く綺麗に書くことが大事だ"
},
{
"i": 9,
"sec": 1019.92,
"end": 1021.6,
"text": "ったじゃでもそれってもうりだからもう"
},
{
"i": 10,
"sec": 1021.59,
"end": 1023.56,
"text": "それはもう守り判定なんだよねこの守りのエ"
},
{
"i": 11,
"sec": 1023.56,
"end": 1024.85,
"text": "リアってどんどん広がっていくから校もね"
},
{
"i": 12,
"sec": 1024.86,
"end": 1025.88,
"text": "でもここは絶対に残らない"
},
{
"i": 13,
"sec": 1026.37,
"end": 1028.96,
"text": "このこっち側を任してこっち側を強くして"
},
{
"i": 14,
"sec": 1029.2,
"end": 1031.8,
"text": "っち側は人間が絶対にやるからそれって自分"
},
{
"i": 15,
"sec": 1031.8,
"end": 1033.63,
"text": "がやってみると絶対分からんのよ社にもよる"
},
{
"i": 16,
"sec": 1033.63,
"end": 1035.32,
"text": "し業務の状態にもよるしいろんなのがある"
},
{
"i": 17,
"sec": 1035.32,
"end": 1037.46,
"text": "からそも自分の業務を知らない人とかもいて"
},
{
"i": 18,
"sec": 1037.46,
"end": 1039.86,
"text": "る気がしてて分化していった時に分いろんな"
},
{
"i": 19,
"sec": 1039.86,
"end": 1041.18,
"text": "業務が出てくるじゃないですか"
},
{
"i": 20,
"sec": 1041.95,
"end": 1044.51,
"text": "分は何をやってるのか知るのも大事だなと思"
},
{
"i": 21,
"sec": 1044.51,
"end": 1046.86,
"text": "ってて言うとね一番やってほしいのは"
},
{
"i": 22,
"sec": 1047.44,
"end": 1049.63,
"text": "が何考えてるか考えてほそれしいが一番ぜ上"
},
{
"i": 23,
"sec": 1049.63,
"end": 1052.67,
"text": "司は私にをやらせてるんでしょうかこを考"
},
{
"i": 24,
"sec": 1052.67,
"end": 1055.04,
"text": "えていかないと攻めの部分って出せない絶番"
},
{
"i": 25,
"sec": 1055.04,
"end": 1057.24,
"text": "簡単なステップとしては上司が何考えてるか"
},
{
"i": 26,
"sec": 1057.24,
"end": 1060.44,
"text": "を考えてほしいしたら分の中でをもっとれば"
},
{
"i": 27,
"sec": 1060.44,
"end": 1062.27,
"text": "いいかっていうのが分かってくる難しいです"
},
{
"i": 28,
"sec": 1062.27,
"end": 1063.01,
"text": "よえ、むずい?"
},
{
"i": 29,
"sec": 1063.01,
"end": 1064.13,
"text": "むずいですよこれむずい?"
},
{
"i": 30,
"sec": 1064.13,
"end": 1065.54,
"text": "絶対できないです司が"
},
{
"i": 31,
"sec": 1065.88,
"end": 1067.7,
"text": "えてるか考えるんだよそういう考えてた後も"
},
{
"i": 32,
"sec": 1067.7,
"end": 1069.65,
"text": "出世してるっすねそうなんよそれできてたら"
},
{
"i": 33,
"sec": 1069.65,
"end": 1071.9,
"text": "多分もうの地位に空いてなかったり自分で"
},
{
"i": 34,
"sec": 1072.13,
"end": 1073.79,
"text": "れてるはずですねでもやろうとしてなく"
},
{
"i": 35,
"sec": 1073.79,
"end": 1073.89,
"text": "ない?"
},
{
"i": 36,
"sec": 1074.01,
"end": 1076.31,
"text": "多分みんなやろうとしてないことはない気が"
},
{
"i": 37,
"sec": 1076.31,
"end": 1076.94,
"text": "します本当?"
},
{
"i": 38,
"sec": 1077.16,
"end": 1078.88,
"text": "上司が何考えてるか考えるとしてる?"
},
{
"i": 39,
"sec": 1078.99,
"end": 1081.02,
"text": "って仕事振られたらしんどいじゃないですか"
},
{
"i": 40,
"sec": 1081.21,
"end": 1083.16,
"text": "んどいよねなった時なんでこれ振ってきてる"
},
{
"i": 41,
"sec": 1083.16,
"end": 1084.48,
"text": "んだろうくらいは考えるじゃないですかでも"
},
{
"i": 42,
"sec": 1084.48,
"end": 1086.03,
"text": "それってさでこんなことやらなきゃいけない"
},
{
"i": 43,
"sec": 1086.03,
"end": 1087.01,
"text": "んだよじゃくて"
},
{
"i": 44,
"sec": 1087.39,
"end": 1089.16,
"text": "司はどんなことがしたいんだろうなんだって"
},
{
"i": 45,
"sec": 1089.16,
"end": 1090.99,
"text": "ベクトルが違うね違いないですなんで俺が"
},
{
"i": 46,
"sec": 1090.99,
"end": 1092.47,
"text": "こんな目に合ってるんだよだるいなどうや"
},
{
"i": 47,
"sec": 1092.47,
"end": 1093.99,
"text": "ったら俺はもっと楽になれるんだじゃん"
},
{
"i": 48,
"sec": 1094.74,
"end": 1097.61,
"text": "うまくいかないのよじゃなくて司はなぜ"
},
{
"i": 49,
"sec": 1097.61,
"end": 1099.46,
"text": "こんなことをしようとしてるんだろうか何を"
},
{
"i": 50,
"sec": 1099.46,
"end": 1101.25,
"text": "成したいんだろうか絶対できないです"
},
{
"i": 51,
"sec": 1102.65,
"end": 1104.81,
"text": "絶対できないそれとの感覚おかしいですね"
},
{
"i": 52,
"sec": 1104.81,
"end": 1106.27,
"text": "それどうやったらできるようになるのでも"
},
{
"i": 53,
"sec": 1106.27,
"end": 1108.23,
"text": "それだけなんだよ仕事っての役に立ちがいい"
},
{
"i": 54,
"sec": 1108.23,
"end": 1110.28,
"text": "んだからだけなんだけどなそれむずいんです"
},
{
"i": 55,
"sec": 1110.28,
"end": 1111.82,
"text": "よねそれをどうやったらできるようになる"
},
{
"i": 56,
"sec": 1111.82,
"end": 1112.9,
"text": "んだろうそれできるようになってほしい"
},
{
"i": 57,
"sec": 1112.9,
"end": 1115.58,
"text": "なんか脳の仕組みとか含めてなんか違う気が"
},
{
"i": 58,
"sec": 1115.58,
"end": 1117.92,
"text": "しててでも考えるだけだよ聞けばいいじゃん"
},
{
"i": 59,
"sec": 1117.92,
"end": 1119.36,
"text": "上司って輩すればいいですか"
},
{
"i": 60,
"sec": 1119.89,
"end": 1121.37,
"text": "ちろんこれをやるんですけどに立ちたい"
},
{
"i": 61,
"sec": 1121.37,
"end": 1122.29,
"text": "というかっとうまく"
},
{
"i": 62,
"sec": 1122.6,
"end": 1124.65,
"text": "たいんですけどこれなんでこういうのやろう"
},
{
"i": 63,
"sec": 1124.65,
"end": 1126.19,
"text": "としてるんですか今どういうプロジェクト"
},
{
"i": 64,
"sec": 1126.52,
"end": 1126.88,
"text": "ですか"
},
{
"i": 65,
"sec": 1127.6,
"end": 1130.07,
"text": "聞くだけじゃしたらこういう目的でこう"
},
{
"i": 66,
"sec": 1130.11,
"end": 1130.97,
"text": "いうことをやろうとしてるんだ"
},
{
"i": 67,
"sec": 1131.47,
"end": 1133.46,
"text": "僕これやってますけど実いうのだったらっと"
},
{
"i": 68,
"sec": 1133.46,
"end": 1133.96,
"text": "よかったりしません?"
},
{
"i": 69,
"sec": 1134.19,
"end": 1136.11,
"text": "ねこの流れ絶対なんない"
},
{
"i": 70,
"sec": 1136.83,
"end": 1139.85,
"text": "絶対そもそも聞けないっすね無理か絶AIと"
},
{
"i": 71,
"sec": 1139.85,
"end": 1141.41,
"text": "共に考えるとかでもいいですかねもちろん"
},
{
"i": 72,
"sec": 1141.41,
"end": 1144.13,
"text": "いいなら行けるかもしれないですよね上司が"
},
{
"i": 73,
"sec": 1144.13,
"end": 1145.23,
"text": "振ってきた仕事を"
},
{
"i": 74,
"sec": 1145.6,
"end": 1147.79,
"text": "にこれなんで俺振られてるんだろうって考え"
},
{
"i": 75,
"sec": 1147.79,
"end": 1149.95,
"text": "させてそこから一緒にタスク含めて考えて"
},
{
"i": 76,
"sec": 1149.95,
"end": 1152.44,
"text": "いくそうそう理解しながらねこでポイントな"
},
{
"i": 77,
"sec": 1152.44,
"end": 1154.27,
"text": "のはで俺こんなのをやらされてるのって言"
},
{
"i": 78,
"sec": 1154.27,
"end": 1156.31,
"text": "ったらそうだね嫌だよねめんどくさいよね"
},
{
"i": 79,
"sec": 1156.31,
"end": 1158.05,
"text": "とかってAIが言う可能性があるからそれに"
},
{
"i": 80,
"sec": 1158.05,
"end": 1160.08,
"text": "引っ張ってたらうんうんうんみたい上司ダメ"
},
{
"i": 81,
"sec": 1160.08,
"end": 1161.7,
"text": "だねとかって言ってうんうんとかってや"
},
{
"i": 82,
"sec": 1161.7,
"end": 1162.64,
"text": "っちゃったらクビになるんで"
},
{
"i": 83,
"sec": 1163.09,
"end": 1164.44,
"text": "こは間違いないよねんでこういうことを"
},
{
"i": 84,
"sec": 1164.44,
"end": 1165.98,
"text": "やってらされてるのっていうのは上司にも"
},
{
"i": 85,
"sec": 1165.98,
"end": 1167.54,
"text": "っと役に立ちたいという前提だからっていう"
},
{
"i": 86,
"sec": 1167.54,
"end": 1169.32,
"text": "風にAIに伝えとかないといけないねまあ確"
},
{
"i": 87,
"sec": 1169.32,
"end": 1172.07,
"text": "か視点取得って一言AIに伝えるといけるか"
},
{
"i": 88,
"sec": 1172.07,
"end": 1173.91,
"text": "もしれないですよね上司の視点を取得したい"
},
{
"i": 89,
"sec": 1173.91,
"end": 1175.61,
"text": "んだけどで俺はこんなことやられてるんだ"
},
{
"i": 90,
"sec": 1175.61,
"end": 1177.56,
"text": "ろうがいいね上司の視点を取得したいんだ"
},
{
"i": 91,
"sec": 1177.56,
"end": 1178.5,
"text": "けどっていうプロンプトを入れてください"
},
{
"i": 92,
"sec": 1178.82,
"end": 1180.4,
"text": "だけで多分できるしたらめっちゃいろんな発"
},
{
"i": 93,
"sec": 1180.4,
"end": 1181.77,
"text": "見があると思その上で"
},
{
"i": 94,
"sec": 1182.08,
"end": 1184.22,
"text": "分が何をやってるかとか把握していきながら"
},
{
"i": 95,
"sec": 1184.16,
"end": 1185.06,
"text": "それをAI化していく"
},
{
"i": 96,
"sec": 1185.7,
"end": 1187.94,
"text": "めっちゃいいプロンプトだと思ううちでも広"
},
{
"i": 97,
"sec": 1187.94,
"end": 1189.89,
"text": "めた方がいいよ上司の視点を取得したいんだ"
},
{
"i": 98,
"sec": 1189.89,
"end": 1191.85,
"text": "けどロンプト超本質だと思う"
},
{
"i": 99,
"sec": 1192.19,
"end": 1194.32,
"text": "ビになりたくない社会人諸君上司の視点を取"
},
{
"i": 100,
"sec": 1194.32,
"end": 1196.29,
"text": "得したいんだけどにゃららっていう風に毎度"
},
{
"i": 101,
"sec": 1196.51,
"end": 1197.27,
"text": "ることりました"
},
{
"i": 102,
"sec": 1197.7,
"end": 1199.42,
"text": "これは今のはめっちゃ本質ね"
},
{
"i": 103,
"sec": 1199.85,
"end": 1202.33,
"text": "ここからじゃあどうすればいいねんってなる"
},
{
"i": 104,
"sec": 1202.33,
"end": 1204.86,
"text": "人も多いと思うからもう仕方ないから具体化"
},
{
"i": 105,
"sec": 1204.86,
"end": 1205.08,
"text": "します"
},
{
"i": 106,
"sec": 1205.44,
"end": 1208.03,
"text": "やってくれます仕方ないそもそもこの考え方"
},
{
"i": 107,
"sec": 1208.03,
"end": 1209.25,
"text": "を持ってたら別にどこの"
},
{
"i": 108,
"sec": 1209.66,
"end": 1211.72,
"text": "所に行っても消えることはないそうこの考え"
},
{
"i": 109,
"sec": 1211.72,
"end": 1215.27,
"text": "方ボテさえすればとえ理の人だろうととえン"
},
{
"i": 110,
"sec": 1215.27,
"end": 1217.58,
"text": "ジニアだろうととえれだけ消えるって言わ"
},
{
"i": 111,
"sec": 1217.58,
"end": 1219.24,
"text": "れてる職業だろうとあなたは生き残ります"
},
{
"i": 112,
"sec": 1219.48,
"end": 1221.05,
"text": "これは答えですけど"
},
{
"i": 113,
"sec": 1221.38,
"end": 1223.18,
"text": "はいえ難しいじゃんこれができないから困"
},
{
"i": 114,
"sec": 1223.18,
"end": 1224.76,
"text": "ってんだよっていう人も多いと思うので"
},
{
"i": 115,
"sec": 1225.09,
"end": 1227.63,
"text": "いう人が使える1ポイント3分クッキング"
},
{
"i": 116,
"sec": 1227.63,
"end": 1229.3,
"text": "すると番簡単なのは"
},
{
"i": 117,
"sec": 1229.8,
"end": 1232.14,
"text": "AIが苦手な領域を攻めることなんだよ"
},
{
"i": 118,
"sec": 1232.32,
"end": 1233.56,
"text": "だからやっぱり物理"
},
{
"i": 119,
"sec": 1235.31,
"end": 1237.41,
"text": "気象価値なのよちの会社で"
},
{
"i": 120,
"sec": 1237.77,
"end": 1238.47,
"text": "いうことできますよ"
},
{
"i": 121,
"sec": 1238.83,
"end": 1241.55,
"text": "みんなできるけどってなっちゃうけど実は田"
},
{
"i": 122,
"sec": 1241.55,
"end": 1244.11,
"text": "舎の方の会社とかだとめっちゃ情報される"
},
{
"i": 123,
"sec": 1244.11,
"end": 1246.48,
"text": "ってやっぱりあるピンチだなって思ってる人"
},
{
"i": 124,
"sec": 1246.48,
"end": 1249.14,
"text": "はいうところにサービスを提供するっていう"
},
{
"i": 125,
"sec": 1249.14,
"end": 1252.48,
"text": "のはちゃくちゃ簡単今だったら京とかでAI"
},
{
"i": 126,
"sec": 1252.76,
"end": 1255.3,
"text": "の導入とかってやると相当レベル高いことを"
},
{
"i": 127,
"sec": 1255.3,
"end": 1258.06,
"text": "きっちりやらないと全然ダメなんだけど田舎"
},
{
"i": 128,
"sec": 1258.06,
"end": 1259.94,
"text": "の方でで資料作れますよ"
},
{
"i": 129,
"sec": 1260.4,
"end": 1262.56,
"text": "ラシAIで作りましょうかってやると"
},
{
"i": 130,
"sec": 1263.18,
"end": 1266.28,
"text": "喜ばれるね舎の方とかは今現時点で地方の広"
},
{
"i": 131,
"sec": 1266.28,
"end": 1268.28,
"text": "告代理店とかがむちゃくちゃボってる現状が"
},
{
"i": 132,
"sec": 1268.28,
"end": 1268.38,
"text": "ある"
},
{
"i": 133,
"sec": 1269.28,
"end": 1271.76,
"text": "め自分のちょっとした能力が必要とされてる"
},
{
"i": 134,
"sec": 1271.76,
"end": 1273.46,
"text": "場所っていっぱいあるからであとは例えば"
},
{
"i": 135,
"sec": 1273.83,
"end": 1275.67,
"text": "法人営業とか人さん"
},
{
"i": 136,
"sec": 1276.97,
"end": 1279.31,
"text": "飲みに行けないのAIは飲みに行って飲んで"
},
{
"i": 137,
"sec": 1279.31,
"end": 1281.78,
"text": "一緒に楽しんで長ちょっとお願いしますよ"
},
{
"i": 138,
"sec": 1281.78,
"end": 1283.09,
"text": "っていうのをるいうとこは結"
},
{
"i": 139,
"sec": 1283.51,
"end": 1286.75,
"text": "強い結局全然儲かるあとは"
},
{
"i": 140,
"sec": 1287.73,
"end": 1290.04,
"text": "AIってみんな思ってるの動画を見るくらい"
},
{
"i": 141,
"sec": 1290.04,
"end": 1292.18,
"text": "だからみんなAIについて不安はあるのその"
},
{
"i": 142,
"sec": 1292.18,
"end": 1294.43,
"text": "不安を解消してあげる仕事やっぱり今めちゃ"
},
{
"i": 143,
"sec": 1294.43,
"end": 1296.94,
"text": "くちゃいいAIの活用を支援しますよ"
},
{
"i": 144,
"sec": 1296.94,
"end": 1299.12,
"text": "っていう提案はんとどこでも通る"
},
{
"i": 145,
"sec": 1299.79,
"end": 1302.11,
"text": "ってるちょっとAI使えるようになるだけで"
},
{
"i": 146,
"sec": 1302.11,
"end": 1304.23,
"text": "他のAI使えない人に対してこれ教えたきゃ"
},
{
"i": 147,
"sec": 1304.23,
"end": 1306.14,
"text": "よく買ってできるじゃいうのとかはめっちゃ"
},
{
"i": 148,
"sec": 1306.14,
"end": 1306.4,
"text": "いいよね"
},
{
"i": 149,
"sec": 1306.92,
"end": 1309.67,
"text": "ポンってポストしたら年が空いてくるよー言"
},
{
"i": 150,
"sec": 1309.67,
"end": 1311.38,
"text": "うてそんな感じなんですねんと入れ食い"
},
{
"i": 151,
"sec": 1311.38,
"end": 1314.64,
"text": "これはねとかもうちょこういうところでしっ"
},
{
"i": 152,
"sec": 1314.64,
"end": 1314.86,
"text": "かりと"
},
{
"i": 153,
"sec": 1315.18,
"end": 1317.31,
"text": "仕事をやれるようになってほしいやっていく"
},
{
"i": 154,
"sec": 1317.31,
"end": 1321.31,
"text": "中でここは残るなは残らないなって部分がず"
},
{
"i": 155,
"sec": 1321.31,
"end": 1323.51,
"text": "つはっきりしていくと思う絶対にこれも形が"
},
{
"i": 156,
"sec": 1323.51,
"end": 1326.51,
"text": "変わっていくの例えば法人営業とかも多分残"
},
{
"i": 157,
"sec": 1326.51,
"end": 1328.92,
"text": "るしばらく残るっき言ったAI導入のやつ"
},
{
"i": 158,
"sec": 1328.92,
"end": 1330.36,
"text": "とかはさ変わっていくわけよだから"
},
{
"i": 159,
"sec": 1331.17,
"end": 1333.97,
"text": "の話とも繋がってくるのかなと思ってて今"
},
{
"i": 160,
"sec": 1333.97,
"end": 1336.39,
"text": "ので言うと稼ぎやすい仕事の例だった"
},
{
"i": 161,
"sec": 1336.39,
"end": 1339.37,
"text": "じゃないですか残る仕事消える仕事のが考え"
},
{
"i": 162,
"sec": 1339.37,
"end": 1341.49,
"text": "方によって消えるものは消えるっていう話だ"
},
{
"i": 163,
"sec": 1341.49,
"end": 1343.7,
"text": "ったじゃないですかえるって言われてても攻"
},
{
"i": 164,
"sec": 1343.7,
"end": 1344.78,
"text": "める動きができて"
},
{
"i": 165,
"sec": 1345.11,
"end": 1347.23,
"text": "をちゃんと改善できる動きができてたらそも"
},
{
"i": 166,
"sec": 1347.23,
"end": 1349.28,
"text": "そも消えない話だったと思うんですけどそも"
},
{
"i": 167,
"sec": 1349.28,
"end": 1352.24,
"text": "そもその動きができる人って法人研修だった"
},
{
"i": 168,
"sec": 1352.24,
"end": 1355.32,
"text": "り導入支援とか今稼げる仕事にもつながって"
},
{
"i": 169,
"sec": 1355.32,
"end": 1358.54,
"text": "くるのかなと思うのでまず今業務の本質を抑"
},
{
"i": 170,
"sec": 1358.54,
"end": 1361.35,
"text": "えるとそこから次のステップアップがえる消"
},
{
"i": 171,
"sec": 1361.35,
"end": 1362.05,
"text": "えないじゃなくて"
},
{
"i": 172,
"sec": 1362.36,
"end": 1364.14,
"text": "げるか稼げないかに変わってくるかな"
},
{
"i": 173,
"sec": 1364.54,
"end": 1366.96,
"text": "そうだねまずにかを知り己を知れば100戦"
},
{
"i": 174,
"sec": 1366.96,
"end": 1369.0,
"text": "あやうからずって言うじゃん失の兵法でね緒"
},
{
"i": 175,
"sec": 1369.0,
"end": 1371.52,
"text": "でAIでやばいわけだからじゃんAIを知る"
},
{
"i": 176,
"sec": 1371.52,
"end": 1374.59,
"text": "のが番対策になるんだよ結局AIってどの業"
},
{
"i": 177,
"sec": 1374.59,
"end": 1376.96,
"text": "務でも生きるじゃんAIをまず学ぶ"
},
{
"i": 178,
"sec": 1377.28,
"end": 1380.16,
"text": "を活用して実際に自分の業務を置き換えら"
},
{
"i": 179,
"sec": 1380.16,
"end": 1382.5,
"text": "れる人間になっていくことそれをやってい"
},
{
"i": 180,
"sec": 1382.5,
"end": 1384.48,
"text": "ければ自分の業務の何が"
},
{
"i": 181,
"sec": 1384.82,
"end": 1385.24,
"text": "要で"
},
{
"i": 182,
"sec": 1385.58,
"end": 1387.76,
"text": "がAIにできるかっていうのがだんだん分か"
},
{
"i": 183,
"sec": 1387.76,
"end": 1390.09,
"text": "ってくるからそれをやるっていうのが一番生"
},
{
"i": 184,
"sec": 1390.09,
"end": 1392.27,
"text": "き残る簡単な方法だよね違いないです"
},
{
"i": 185,
"sec": 1392.62,
"end": 1395.42,
"text": "える残るみたいな話している時点でちょっと"
},
{
"i": 186,
"sec": 1395.42,
"end": 1398.36,
"text": "浅いな浅いってな感じです消える残るは浅い"
},
{
"i": 187,
"sec": 1398.86,
"end": 1399.9,
"text": "が本質ってことですか"
},
{
"i": 188,
"sec": 1401.0,
"end": 1402.72,
"text": "える残るなんて気にしたって変わらん"
},
{
"i": 189,
"sec": 1402.72,
"end": 1403.38,
"text": "じゃないですかもう"
},
{
"i": 190,
"sec": 1403.74,
"end": 1404.66,
"text": "学んでどうするのって"
},
{
"i": 191,
"sec": 1405.22,
"end": 1407.9,
"text": "まさにそうだよねだから転職活動するのか"
},
{
"i": 192,
"sec": 1407.9,
"end": 1410.26,
"text": "って話だと思うんでもうAI使えるようにな"
},
{
"i": 193,
"sec": 1410.26,
"end": 1412.3,
"text": "るのが多分一番早くそうそうてAIを使える"
},
{
"i": 194,
"sec": 1412.3,
"end": 1414.26,
"text": "ようになって自分の業務を消すっていう消"
},
{
"i": 195,
"sec": 1414.26,
"end": 1416.74,
"text": "える前に消すっていう一番最初に消せたやつ"
},
{
"i": 196,
"sec": 1416.74,
"end": 1418.96,
"text": "が偉いんだからせたらめっちゃ儲かるよ他"
},
{
"i": 197,
"sec": 1419.37,
"end": 1420.01,
"text": "会社の"
}
